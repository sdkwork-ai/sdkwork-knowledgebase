{
  "schemaVersion": 1,
  "kind": "sdkwork.client-env-materialization",
  "application": "sdkwork-knowledgebase",
  "command": "pnpm workflow:materialize-client-env",
  "sourceIdentity": {
    "deploymentProfileKeys": [
      "SDKWORK_DEPLOYMENT_PROFILE",
      "SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE"
    ],
    "environmentKeys": [
      "SDKWORK_ENVIRONMENT",
      "SDKWORK_KNOWLEDGEBASE_ENVIRONMENT"
    ],
    "profileIdKeys": [
      "SDKWORK_PROFILE_ID",
      "SDKWORK_KNOWLEDGEBASE_PROFILE_ID"
    ]
  },
  "surfaces": [
    {
      "id": "sdkwork-knowledgebase-pc",
      "root": "apps/sdkwork-knowledgebase-pc",
      "format": "vite",
      "runtimeTarget": "browser",
      "identityPrefixes": [
        "VITE_SDKWORK_KNOWLEDGEBASE"
      ],
      "includePrefixes": [
        "VITE_SDKWORK_"
      ],
      "requiredOutputKeys": [
        "VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL",
        "VITE_SDKWORK_KNOWLEDGEBASE_PLATFORM_API_GATEWAY_HTTP_URL"
      ],
      "accessToken": {
        "appId": "sdkwork-knowledgebase-pc",
        "tenantId": "100001",
        "organizationId": "0",
        "permissionScope": [
          "iam:self"
        ]
      }
    },
    {
      "id": "sdkwork-knowledgebase-flutter-mobile",
      "root": "apps/sdkwork-knowledgebase-flutter-mobile",
      "format": "flutter",
      "runtimeTarget": "flutter-android",
      "bindings": {},
      "accessToken": {
        "appId": "sdkwork-knowledgebase",
        "tenantId": "100001",
        "organizationId": "0",
        "permissionScope": [
          "iam:self"
        ]
      }
    },
    {
      "id": "sdkwork-knowledgebase-mini-program",
      "root": "apps/sdkwork-knowledgebase-mini-program",
      "format": "mini-program",
      "runtimeTarget": "mini-program",
      "bindings": {},
      "accessToken": {
        "appId": "sdkwork-knowledgebase",
        "tenantId": "100001",
        "organizationId": "0",
        "permissionScope": [
          "iam:self"
        ]
      }
    },
    {
      "id": "sdkwork-knowledgebase-h5",
      "root": "apps/sdkwork-knowledgebase-h5",
      "format": "vite",
      "runtimeTarget": "browser",
      "bindings": {},
      "accessToken": {
        "appId": "sdkwork-knowledgebase-h5",
        "tenantId": "100001",
        "organizationId": "0",
        "permissionScope": [
          "iam:self"
        ]
      }
    },
    {
      "id": "sdkwork-knowledgebase-harmony-mobile",
      "root": "apps/sdkwork-knowledgebase-harmony-mobile",
      "format": "harmony-native",
      "runtimeTarget": "harmony-native",
      "accessToken": {
        "appId": "sdkwork-knowledgebase",
        "tenantId": "100001",
        "organizationId": "0",
        "permissionScope": [
          "iam:self"
        ]
      }
    }
  ],
  "profiles": [
    "standalone.development",
    "standalone.test",
    "standalone.staging",
    "standalone.demo",
    "standalone.production",
    "cloud.development",
    "cloud.test",
    "cloud.staging",
    "cloud.demo",
    "cloud.production"
  ]
}
