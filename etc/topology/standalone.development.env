
SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=standalone
SDKWORK_DRIVE_DOMAIN_OUTBOX_EMBEDDED_DISPATCH=false
SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=development
SDKWORK_ENVIRONMENT=development
SDKWORK_IAM_ENVIRONMENT=development
SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=dev
SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=server
SDKWORK_KNOWLEDGEBASE_PROFILE_ID=standalone.development
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1
SDKWORK_KNOWLEDGEBASE_DEV_ALLOWED_ORIGINS=http://127.0.0.1:5184,http://localhost:5184
# Must match sdkwork.app.config.json backend.tenantId and IAM login tenant.
SDKWORK_KNOWLEDGEBASE_TENANT_ID=100001
SDKWORK_KNOWLEDGEBASE_ORGANIZATION_ID=0
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_ACTOR_ID=9001
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_CHECKPOINT_PAGE_SIZE=50
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_BATCH_SIZE=25
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_LEASE_SECONDS=120
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_RETRY_DELAY_SECONDS=30
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_MAX_ATTEMPTS=20
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_BATCH_SIZE=10
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_LEASE_SECONDS=120
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_RETRY_DELAY_SECONDS=30
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_MAX_ATTEMPTS=10
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_DELIVERY_RENEWAL_PAGE_SIZE=50
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_DELIVERY_RENEWAL_INTERVAL_SECONDS=3600

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KNOWLEDGEBASE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18081

SDKWORK_KNOWLEDGEBASE_DRIVE_STORAGE_ROOT=./.sdkwork/runtime/knowledgebase/drive-storage

# Public web search for retrieval requests with metadata includePublicWeb=true.
# SDKWORK_KNOWLEDGEBASE_PUBLIC_WEB_SEARCH_ENABLED=true
# SDKWORK_KNOWLEDGEBASE_SEARXNG_BASE_URL=http://127.0.0.1:8080

# Standalone gateway PostgreSQL profile (IAM/login + application ingress + worker process).
# Default `pnpm dev` uses `--database postgres`; orchestration sets SDKWORK_DATABASE_URL from .env.postgres.
# Application server development uses PostgreSQL; SQLite is not a public runtime profile.
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
# Load from .env.postgres (copy from .env.postgres.example). Do not commit secrets here.
# SDKWORK_DATABASE_PASSWORD=
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# Load from .env.postgres. Required for local IAM token signing.
# SDKWORK_IAM_TENANT_SIGNING_MASTER_SECRET=

VITE_SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=development
VITE_SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=dev
VITE_SDKWORK_KNOWLEDGEBASE_BUILD_MODE=development
VITE_SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=browser
VITE_SDKWORK_KNOWLEDGEBASE_DEV_SAME_ORIGIN_API=true
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:18081
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:3900
VITE_SDKWORK_IAM_APP_API_BASE_URL=http://127.0.0.1:18081


