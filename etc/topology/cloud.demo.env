# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=cloud
SDKWORK_DRIVE_DOMAIN_OUTBOX_EMBEDDED_DISPATCH=false
SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=demo
SDKWORK_ENVIRONMENT=demo
SDKWORK_IAM_ENVIRONMENT=demo
SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=demo
SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=container
SDKWORK_KNOWLEDGEBASE_PROFILE_ID=cloud.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KNOWLEDGEBASE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=https://knowledgebase-demo.sdkwork.com/app/v3/api
SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=https://knowledgebase-admin-demo.sdkwork.com/backend/v3/api
SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=https://knowledge-demo.sdkwork.com/knowledge/v3/api
SDKWORK_KNOWLEDGEBASE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

VITE_SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=demo
VITE_SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=demo
VITE_SDKWORK_KNOWLEDGEBASE_BUILD_MODE=demo
VITE_SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=browser
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=https://knowledgebase-demo.sdkwork.com/app/v3/api
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=https://knowledgebase-admin-demo.sdkwork.com/backend/v3/api
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=https://knowledge-demo.sdkwork.com/knowledge/v3/api
VITE_SDKWORK_KNOWLEDGEBASE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_IAM_APP_API_BASE_URL=https://api-demo.sdkwork.com
