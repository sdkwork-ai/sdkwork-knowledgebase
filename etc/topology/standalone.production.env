
SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=standalone
SDKWORK_DRIVE_DOMAIN_OUTBOX_EMBEDDED_DISPATCH=false
SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=production
SDKWORK_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=https://knowledgebase.sdkwork.com,https://knowledgebase.birdcoder.com,https://knowledgebase.dtupay.com,https://knowledgebase.noaper.com,https://knowledgebase.sdkwork.cn,https://knowledgebase.birdcoder.cn,https://knowledgebase.dtupay.cn,https://knowledgebase.noaper.cn,https://knowledgebase.skubc.com,https://knowledgebase.skubc.cn,https://knowledgebase.zowalk.com,https://knowledgebase.zowalk.cn,https://knowledgebase.offer86.com,https://knowledgebase.offer86.cn,https://knowledgebase.86offer.com,https://knowledgebase.86offer.cn,https://knowledgebase-admin.sdkwork.com,https://knowledgebase-admin.birdcoder.com,https://knowledgebase-admin.dtupay.com,https://knowledgebase-admin.noaper.com,https://knowledgebase-admin.sdkwork.cn,https://knowledgebase-admin.birdcoder.cn,https://knowledgebase-admin.dtupay.cn,https://knowledgebase-admin.noaper.cn,https://knowledgebase-admin.skubc.com,https://knowledgebase-admin.skubc.cn,https://knowledgebase-admin.zowalk.com,https://knowledgebase-admin.zowalk.cn,https://knowledgebase-admin.offer86.com,https://knowledgebase-admin.offer86.cn,https://knowledgebase-admin.86offer.com,https://knowledgebase-admin.86offer.cn,https://knowledge.sdkwork.com,https://knowledge.birdcoder.com,https://knowledge.dtupay.com,https://knowledge.noaper.com,https://knowledge.sdkwork.cn,https://knowledge.birdcoder.cn,https://knowledge.dtupay.cn,https://knowledge.noaper.cn,https://knowledge.skubc.com,https://knowledge.skubc.cn,https://knowledge.zowalk.com,https://knowledge.zowalk.cn,https://knowledge.offer86.com,https://knowledge.offer86.cn,https://knowledge.86offer.com,https://knowledge.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_IAM_ENVIRONMENT=production
SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=prod
SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=server
SDKWORK_KNOWLEDGEBASE_PROFILE_ID=standalone.production
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KNOWLEDGEBASE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18081

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=16

# Apply pending schema migrations on boot (explicit; manifest default is false).
SDKWORK_DATABASE_AUTO_MIGRATE=1
SDKWORK_KNOWLEDGEBASE_TENANT_ID=1
# One fixed non-zero organization per deployment (fail-closed RLS requires it).
SDKWORK_KNOWLEDGEBASE_ORGANIZATION_ID=1
SDKWORK_DATABASE_MAX_CONNECTIONS=16
SDKWORK_KNOWLEDGEBASE_DRIVE_STORAGE_ROOT=/var/lib/sdkwork/apps/sdkwork-knowledgebase/drive
SDKWORK_KNOWLEDGEBASE_SECRETS_ENCRYPTION_KEY_FILE=/etc/sdkwork/secrets-encryption-key.secret
# Dedicated tenant-local service actor used only for auditable Wiki maintenance commands.
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_ACTOR_ID=1
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_CHECKPOINT_PAGE_SIZE=50
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_BATCH_SIZE=25
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_LEASE_SECONDS=120
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_RETRY_DELAY_SECONDS=30
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_MAX_ATTEMPTS=20
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_BATCH_SIZE=10
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_LEASE_SECONDS=120
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_RETRY_DELAY_SECONDS=30
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_SOURCE_MAX_ATTEMPTS=10
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_DELIVERY_RENEWAL_PAGE_SIZE=50
SDKWORK_KNOWLEDGEBASE_WORKER_WIKI_EVENT_DELIVERY_RENEWAL_INTERVAL_SECONDS=3600

VITE_SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=production
VITE_SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=prod
VITE_SDKWORK_KNOWLEDGEBASE_BUILD_MODE=production
VITE_SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=desktop
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18081
