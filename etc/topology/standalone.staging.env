SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=standalone
SDKWORK_DRIVE_DOMAIN_OUTBOX_EMBEDDED_DISPATCH=false
SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=staging
SDKWORK_ENVIRONMENT=staging
SDKWORK_IAM_ENVIRONMENT=staging
SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=staging
SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=server
SDKWORK_KNOWLEDGEBASE_PROFILE_ID=standalone.staging
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KNOWLEDGEBASE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_BIND=0.0.0.0:18081
SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18081

VITE_SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=staging
VITE_SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=staging
VITE_SDKWORK_KNOWLEDGEBASE_BUILD_MODE=staging
VITE_SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=browser
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:18081
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:18081
VITE_SDKWORK_IAM_APP_API_BASE_URL=http://127.0.0.1:18081



# Platform API gateway: standalone development binds the shared local gateway.
VITE_SDKWORK_KNOWLEDGEBASE_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
