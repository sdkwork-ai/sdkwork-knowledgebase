# SDKWork standalone.production overrides (edit this file, not the resolved profile)
VITE_SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=desktop
SDKWORK_DATABASE_MAX_CONNECTIONS=16
SDKWORK_KNOWLEDGEBASE_PROFILE_ID=standalone.production
SDKWORK_KNOWLEDGEBASE_DRIVE_STORAGE_ROOT=/var/lib/sdkwork/apps/sdkwork-knowledgebase/drive
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_KNOWLEDGEBASE_SECRETS_ENCRYPTION_KEY_FILE=/etc/sdkwork/secrets-encryption-key.secret
