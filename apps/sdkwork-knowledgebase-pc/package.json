    "@sdkwork/drive-app-sdk": "workspace:*",
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/iam-contracts": "workspace:*",
    "@sdkwork/iam-credential-entry": "workspace:*",
    "@sdkwork/knowledgebase-app-sdk": "workspace:*",
    "@sdkwork/knowledgebase-pc-knowledge": "workspace:*",
    "@sdkwork/sdkwork-knowledgebase-pc-knowledgebase": "workspace:*",
    "@sdkwork/sdkwork-knowledgebase-pc-shell": "workspace:*",
    "@sdkwork/ui-pc-react": "workspace:*",
    "@sdkwork/utils": "workspace:*",
