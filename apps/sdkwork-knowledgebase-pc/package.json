    "react-router-dom": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "sdkwork-knowledgebase-pc-admin-core": "workspace:*",
    "sdkwork-knowledgebase-pc-admin-provider": "workspace:*",
    "sdkwork-knowledgebase-pc-core": "workspace:*",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
