    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@uiw/react-md-editor": "^4.1.2",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^1.6.7",
    "i18next": "^26.5.3",
