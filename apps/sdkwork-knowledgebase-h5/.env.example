# SDKWork Knowledgebase H5 development topology template.
# Copy to .env.local and adjust for your machine. Do not commit secrets.
# Canonical profile source: ../../../etc/sdkwork.deployment.config.json

VITE_SDKWORK_KNOWLEDGEBASE_H5_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KNOWLEDGEBASE_H5_ENVIRONMENT=development
VITE_SDKWORK_KNOWLEDGEBASE_H5_CONFIG_PROFILE=dev
VITE_SDKWORK_KNOWLEDGEBASE_H5_BUILD_MODE=development
VITE_SDKWORK_KNOWLEDGEBASE_H5_RUNTIME_TARGET=browser
VITE_SDKWORK_KNOWLEDGEBASE_H5_BROWSER_BASE_PATH=/
VITE_SDKWORK_KNOWLEDGEBASE_H5_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_KNOWLEDGEBASE_H5_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900

# Single shared API base-url key resolved through @sdkwork/sdk-common.
SDKWORK_API_BASE_URL=http://127.0.0.1:18081

# SDKWork private bootstrap credential (blank in tracked files).
SDKWORK_ACCESS_TOKEN=
