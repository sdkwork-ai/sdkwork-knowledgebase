# SDKWork Knowledgebase local PostgreSQL development profile. DEV-ONLY credentials:
# rotate them before any shared or staging use; never reuse them in production.
# Copy to config/host/postgres.env for host-local overrides. Do not commit config/host/postgres.env.
#
# PostgreSQL connection identity is unified across all SDKWork applications.
# See sdkwork-specs/ENVIRONMENT_SPEC.md §7.1 and sdkwork-cloudrouter-router/config/host/postgres.env.example.

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1

# Local IAM tenant signing secret for development only. Override in gitignored config/host/postgres.env.
SDKWORK_IAM_TENANT_SIGNING_MASTER_SECRET=sdkwork-knowledgebase-dev-signing-secret

SDKWORK_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_DATABASE_ADMIN_PORT=5432
SDKWORK_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_DATABASE_ADMIN_PASSWORD=postgres_admin_pass
SDKWORK_DATABASE_ADMIN_DATABASE=postgres
SDKWORK_DATABASE_ADMIN_SSL_MODE=disable

# Optional: direct connection URL. If set, it takes precedence over split fields above.
# SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable
