      "upstreamVersion",
      "adapterCommit",
      "contractSuiteVersion",
      "verifiedAt",
      "expiresAt",
      "environment",
      "workflowRunRef",
      "reviewedBy",
      "qualityEvaluationRef",
      "qualityEvaluationSha256",
      "contractReportRef",
      "contractReportSha256",
      "loadSloRef",
      "loadSloSha256",
      "outageRecoveryRef",
      "outageRecoverySha256",
      "licensingReviewRef",
      "licensingReviewSha256",
      "licensingApproval",
      "securityPrivacyReviewRef",
      "securityPrivacyReviewSha256",
      "securityPrivacyApproval"
    ],
    "productionEvidence": [
      "upstreamVersion",
      "evidenceRef",
      "evidenceSha256",
      "verifiedAt",
      "licensingApproval",
      "securityPrivacyApproval"
    ]
