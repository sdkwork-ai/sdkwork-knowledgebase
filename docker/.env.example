# sdkwork-knowledgebase docker compose environment template.
# Copy to the repository root as `.env` and adjust values:
#   cp docker/.env.example .env
# docker compose reads `.env` next to docker-compose.yml automatically.
# Every value below has a built-in local-development default, so this file is
# optional; it exists to make deployment-time configuration explicit.

# --- Process log level (tracing reads RUST_LOG directly) ---
# Set to debug/trace to increase verbosity at deployment time.
RUST_LOG=info

# --- Gateway runtime posture ---
# development | test | staging | production.
# development/test: no IM RPC cluster or Redis hardening required, IAM
# development authentication fallback enabled (bootstrap Access-Token login).
# staging/production: Redis + PostgreSQL required, and all
# SDKWORK_KNOWLEDGEBASE_IM_RPC_* keys must be injected (see
# etc/topology/standalone.production.env).
KNOWLEDGEBASE_ENVIRONMENT=development

# --- Gateway resource guardrails (docker compose deploy limits) ---
KNOWLEDGEBASE_CPU_LIMIT=4.0
KNOWLEDGEBASE_MEMORY_LIMIT=4g
KNOWLEDGEBASE_CPU_RESERVATION=1.0
KNOWLEDGEBASE_MEMORY_RESERVATION=1g
KNOWLEDGEBASE_WORKER_CPU_LIMIT=2.0
KNOWLEDGEBASE_WORKER_MEMORY_LIMIT=2g
KNOWLEDGEBASE_WORKER_CPU_RESERVATION=0.5
KNOWLEDGEBASE_WORKER_MEMORY_RESERVATION=512m

# --- Host port mapping ---
# The gateway binds 18081 inside the container; 3904 on the host keeps it off
# the `pnpm dev` ports (18081 gateway, 5184 vite) and the 3900 platform
# gateway. The deployment nginx proxies the test domains to this port.
KNOWLEDGEBASE_HOST_HTTP_PORT=3904

# --- Connection pools ---
KNOWLEDGEBASE_DATABASE_MAX_CONNECTIONS=30
KNOWLEDGEBASE_DATABASE_MIN_CONNECTIONS=5
KNOWLEDGEBASE_DATABASE_ACQUIRE_TIMEOUT=30
KNOWLEDGEBASE_DATABASE_IDLE_TIMEOUT=600
KNOWLEDGEBASE_DATABASE_MAX_LIFETIME=1800
# PostgreSQL server-side connection ceiling (default 200).
PG_MAX_CONNECTIONS=200

# --- PostgreSQL (compose `postgres` service) ---
KNOWLEDGEBASE_POSTGRES_DB=sdkwork_ai_prod
KNOWLEDGEBASE_POSTGRES_SCHEMA=sdkwork_ai_prod
KNOWLEDGEBASE_POSTGRES_USER=sdkwork_ai_prod
# Change this password; the same value must reach the gateway via the
# database fields in docker-compose.yml.
KNOWLEDGEBASE_POSTGRES_PASSWORD=sdkwork_ai_prod

# --- Runtime secrets (change all of these for any real deployment) ---
# IAM tenant signing master secret (development default; production must use
# a strong secret via SDKWORK_IAM_TENANT_SIGNING_MASTER_SECRET_FILE).
SDKWORK_IAM_TENANT_SIGNING_MASTER_SECRET=sdkwork-knowledgebase-dev-signing-secret
# Provider/credential encryption key (>= 32 bytes; production must use
# SDKWORK_KNOWLEDGEBASE_SECRETS_ENCRYPTION_KEY_FILE with a mounted secret).
SDKWORK_KNOWLEDGEBASE_SECRETS_ENCRYPTION_KEY=sdkwork-knowledgebase-docker-dev-encryption-key-000000
# IAM super-admin bootstrap password: when set, the IAM bootstrap provisions/
# updates the password credential for the canonical admin@sdkwork.com user on
# startup. Set a strong value for a quick admin login (knowledgebase write
# permissions); leave empty to rely on credential-entry registration (new
# users start without write permissions).
SDKWORK_IAM_SUPER_ADMIN_PASSWORD=

# --- Tenant identity ---
KNOWLEDGEBASE_TENANT_ID=100001
KNOWLEDGEBASE_ORGANIZATION_ID=0
KNOWLEDGEBASE_SNOWFLAKE_NODE_ID=1
# Wiki maintenance actor used by the worker (canonical positive BIGINT).
KNOWLEDGEBASE_WORKER_WIKI_ACTOR_ID=9001

# --- Browser CORS allow-list (API plane) ---
# Every origin that serves the portal from a browser must be listed here
# (comma/space separated). Defaults cover the three test domains plus local
# host ports. This is the canonical shared key (SOURCE_CONFIG_SPEC) used by
# the IAM and Knowledgebase API surfaces; docker-compose.yml maps it into the
# container as-is.
SDKWORK_CORS_ALLOWED_ORIGINS=http://testapikb.sdkwork.com,http://testapikb.birdcoder.com,http://testapikb.dtupay.com,http://localhost:3904,http://127.0.0.1:3904

# --- External PostgreSQL/Redis override (production) ---
# Set these to point the containers at managed services instead of the
# compose services, and unset/replace the compose dependency wiring
# accordingly.
# KNOWLEDGEBASE_POSTGRES_HOST=db.example.com
# KNOWLEDGEBASE_POSTGRES_PORT=5432
# KNOWLEDGEBASE_REDIS_HOST=redis.example.com
# KNOWLEDGEBASE_REDIS_PORT=6379
# KNOWLEDGEBASE_REDIS_KEY_PREFIX=sdkwork:knowledgebase
