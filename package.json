{
  "name": "sdkwork-knowledgebase-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@sdkwork/app-topology": "workspace:*"
  },
  "scripts": {
    "workflow:materialize-client-env": "node ../sdkwork-specs/tools/materialize-client-env.mjs --root .",
    "check:client-env": "node ../sdkwork-specs/tools/materialize-client-env.mjs --root . --check",
    "stop": "pnpm exec sdkwork-app stop",
    "dev": "pnpm dev:standalone",
    "dev:browser": "pnpm dev:browser:postgres:standalone",
    "dev:browser:postgres": "pnpm exec sdkwork-app dev --runtime-target browser --deployment-profile standalone",
    "dev:browser:postgres:standalone": "pnpm exec sdkwork-app dev --runtime-target browser --deployment-profile standalone",
    "dev:desktop": "pnpm dev:desktop:postgres:standalone",
    "dev:desktop:postgres": "pnpm exec sdkwork-app dev --runtime-target desktop --deployment-profile standalone",
    "dev:desktop:postgres:standalone": "pnpm exec sdkwork-app dev --runtime-target desktop --deployment-profile standalone",
    "build": "pnpm exec sdkwork-app build",
    "build:desktop": "pnpm --dir apps/sdkwork-knowledgebase-pc run build:desktop",
    "build:server": "cargo build --release -p sdkwork-api-knowledgebase-standalone-gateway",
    "build:container": "node scripts/build-knowledgebase-container.mjs",
    "build:container:check": "node scripts/build-knowledgebase-container.mjs --check --dry-run",
    "deploy:docker:wsl": "node scripts/deploy-wsl-docker.mjs",
    "test": "pnpm exec sdkwork-app test",
    "test:rust": "cargo test --workspace -- --quiet",
    "test:provider-certification": "node tools/run_provider_certification.mjs --execute",
    "test:security": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-security.test.mjs && node --test --experimental-test-isolation=none scripts/verify-knowledgebase-permission-bootstrap.test.mjs",
    "test:observability": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-observability.test.mjs",
    "test:smoke": "node --test --experimental-test-isolation=none scripts/smoke-knowledgebase-api.test.mjs",
    "test:launch-readiness": "node --test --experimental-test-isolation=none scripts/verify-launch-runbook.test.mjs && node --test --experimental-test-isolation=none scripts/smoke-knowledgebase-open-api.test.mjs && node --test --experimental-test-isolation=none scripts/smoke-knowledgebase-admin-ingest.test.mjs",
    "test:phase2-readiness": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-phase2-readiness.test.mjs && node --test --experimental-test-isolation=none scripts/verify-knowledgebase-tenant-quota.test.mjs && pnpm test:multi-tenant-isolation && pnpm test:billing-metering",
    "test:multi-tenant-isolation": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-multi-tenant-isolation.test.mjs",
    "test:tenant-quota": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-tenant-quota.test.mjs",
    "test:billing-metering": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-billing-metering.test.mjs",
    "test:e2e": "node --test --experimental-test-isolation=none scripts/e2e-knowledgebase-pc-bootstrap.test.mjs && node --test --experimental-test-isolation=none scripts/e2e-knowledgebase-pc-browser.test.mjs",
    "test:e2e:playwright": "pnpm --dir apps/sdkwork-knowledgebase-pc run test:e2e",
    "test:topology": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-topology.test.mjs",
    "test:web-domain-routing-standard": "node scripts/dev/sdkwork-knowledgebase-web-domain-routing-standard.test.mjs",
    "test:frontend": "pnpm --dir apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-commons test && pnpm --dir apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-core test && pnpm --dir apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-search test && pnpm --dir apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-knowledgebase test && pnpm --dir apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-shell test && pnpm --dir apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-admin-core test && pnpm --dir apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-admin-provider test",
    "check": "pnpm exec sdkwork-app check",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "check:utils-integration": "node tools/check_utils_integration_standard.mjs",
    "check:okf-standard": "node tools/check_okf_knowledge_bundle_standard.mjs",
    "check:external-engine-catalog": "node tools/check_external_knowledge_engine_catalog.mjs",
    "check:provider-certification": "node --test tools/provider_certification.test.mjs && node tools/run_provider_certification.mjs",
    "check:knowledge-engine-spi": "node --test tools/evaluate_knowledge_engine_retrieval.test.mjs tools/quality_evaluation_evidence.test.mjs && node tools/check_knowledge_engine_spi_standard.mjs",
    "check:verification-pipeline": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-verification-pipeline.test.mjs",
    "check:architecture-alignment": "node tools/check_sdkwork_knowledgebase_architecture_alignment.mjs",
    "check:pc-app-hygiene": "node tools/check_pc_app_hygiene.mjs",
    "check:source-hygiene": "node --test --experimental-test-isolation=none scripts/verify-knowledgebase-source-hygiene.test.mjs",
    "check:organization-scope-sql": "node tools/check_organization_scope_sql.mjs",
    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix knowledgebase,kb",
    "check:agent-workflow-standard": "node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root .",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "typecheck": "pnpm --dir apps/sdkwork-knowledgebase-pc run lint",
    "lint": "pnpm --dir apps/sdkwork-knowledgebase-pc run lint",
    "lint:strict:pc-core": "pnpm --dir apps/sdkwork-knowledgebase-pc run lint:strict:core",
    "api:materialize": "node tools/sync-route-manifest-json.mjs && node tools/align-knowledgebase-openapi-standard.mjs && node scripts/align-app-api-int64-string-fields.mjs && node tools/apply-knowledgebase-openapi-auth-mode.mjs && node tools/apply-knowledgebase-openapi-permissions.mjs && node sdks/standardize-knowledgebase-sdk-family.mjs && node tools/materialize-apis-authority.mjs && node tools/patch-commerce-app-openapi.mjs",
    "api:align-envelope": "node tools/align-knowledgebase-openapi-standard.mjs && node tools/patch-commerce-app-openapi.mjs",
    "api:materialize:check": "node tools/sync-route-manifest-json.mjs --check && node tools/align-knowledgebase-openapi-standard.mjs --check && node scripts/align-app-api-int64-string-fields.mjs --check && node tools/apply-knowledgebase-openapi-auth-mode.mjs --check && node tools/apply-knowledgebase-openapi-permissions.mjs --check && node sdks/standardize-knowledgebase-sdk-family.mjs --check && node tools/materialize-apis-authority.mjs --check && node tools/patch-commerce-app-openapi.mjs --check",
    "api:auth-mode": "node tools/apply-knowledgebase-openapi-auth-mode.mjs",
    "api:auth-mode:check": "node tools/apply-knowledgebase-openapi-auth-mode.mjs --check",
    "api:check": "node tools/materialize-apis-authority.mjs --check",
    "sdk:generate:check": "node sdks/standardize-knowledgebase-sdk-family.mjs --check",
    "sdk:check": "node sdks/test/verify-sdk-ownership-boundaries.test.mjs",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_knowledgebase_baseline.sql --module-id knowledgebase --owner knowledgebase-platform --prefixes kb_ --engines postgres",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "deploy:plan": "pnpm exec sdkwork-app deploy:plan",
    "deploy:plan:standalone": "pnpm exec sdkwork-app deploy:plan --deployment-profile standalone",
    "deploy:plan:cloud": "pnpm exec sdkwork-app deploy:plan --deployment-profile cloud",
    "deploy:apply": "pnpm exec sdkwork-app deploy:apply",
    "deploy:apply:standalone": "pnpm exec sdkwork-app deploy:apply --deployment-profile standalone",
    "deploy:apply:cloud": "pnpm exec sdkwork-app deploy:apply --deployment-profile cloud",
    "deploy:rollback": "pnpm exec sdkwork-app deploy:rollback",
    "deploy:rollback:standalone": "pnpm exec sdkwork-app deploy:rollback --deployment-profile standalone",
    "deploy:rollback:cloud": "pnpm exec sdkwork-app deploy:rollback --deployment-profile cloud",
    "deploy:validate": "pnpm exec sdkwork-app deploy:validate",
    "deploy:validate:standalone": "pnpm exec sdkwork-app deploy:validate --deployment-profile standalone",
    "deploy:validate:cloud": "pnpm exec sdkwork-app deploy:validate --deployment-profile cloud",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "test:contract:database": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
    "db:postgres:init": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode init --config .env.postgres --app-root .",
    "db:postgres:plan": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode plan --config .env.postgres --app-root . --dry-run",
    "_sdkwork:build": "pnpm --dir apps/sdkwork-knowledgebase-pc run build",
    "_sdkwork:test": "pnpm topology:validate && pnpm test:topology && pnpm test:frontend && pnpm test:rust && pnpm test:smoke && pnpm test:launch-readiness && pnpm test:e2e && pnpm test:observability && pnpm test:security && pnpm db:validate",
    "_sdkwork:check": "pnpm api:materialize:check && pnpm check:architecture-alignment && pnpm check:app-composition && pnpm check:pc-app-hygiene && pnpm check:source-hygiene && pnpm check:organization-scope-sql && pnpm check:utils-integration && pnpm check:pnpm-script-standard && pnpm check:agent-workflow-standard && pnpm check:okf-standard && pnpm check:external-engine-catalog && pnpm check:provider-certification && pnpm check:knowledge-engine-spi && pnpm check:verification-pipeline",
    "_sdkwork:verify": "powershell -ExecutionPolicy Bypass -File tools/verify_phase1.ps1 && pnpm check && pnpm test:security && pnpm test:observability && pnpm test:launch-readiness && pnpm test:phase2-readiness && pnpm deploy:validate && pnpm run check:app-composition",
    "_sdkwork:clean": "cargo clean && node -e \"const fs=require('node:fs'); for (const dir of ['artifacts','target']) { if (fs.existsSync(dir)) fs.rmSync(dir,{recursive:true,force:true}); }\"",
    "dev:standalone": "pnpm exec sdkwork-app dev --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --deployment-profile cloud",
    "dev:browser:cloud": "pnpm exec sdkwork-app dev --runtime-target browser --deployment-profile cloud"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}